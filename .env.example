# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# From `bun run auth:google`
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Calendar to check for conflicts and book into (default: primary)
GOOGLE_CALENDAR_ID=primary

# Optional: more calendars that block times. Comma-separated.
# Refresh tokens for other Google accounts (run `bun run auth:google` signed in as each);
# their primary calendars are checked for conflicts.
GOOGLE_EXTRA_REFRESH_TOKENS=
# Calendar IDs already shared with the main account (Settings > "Integrate calendar" > Calendar ID).
GOOGLE_CONFLICT_CALENDARS=
